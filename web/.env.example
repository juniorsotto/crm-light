# CRM Light (Colsubsidio) — web env. Copy to .env.local and fill in.

# Supabase project (the CRM Light DB — separate from Notifiica). Public, browser-exposed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# ▶ Play Proactivo — server-only (NOT NEXT_PUBLIC): the /api/activate-lead route handler forwards
# to Notifiica's activate-lead edge function with the shared secret + the demo line's phone_number_id.
NOTIFIICA_ACTIVATE_URL=http://localhost:54321/functions/v1/activate-lead
NOTIFIICA_CALLBACK_SECRET=<same-CALLBACK_SECRET-as-notifiica-functions-env>
TENANT_PHONE_NUMBER_ID=<the-demo-line-phone-number-id>
